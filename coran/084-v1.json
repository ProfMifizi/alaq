{"n":84,"v":[[["إِذَا","السَّمَاءُ","انشَقَّتْ"],["quand","le ciel","se fendra"],"Lorsque le ciel se déchirera,"],[["وَأَذِنَتْ","لِرَبِّهَا","وَحُقَّتْ"],["et obéira","à son Seigneur","et y sera tenu"],"obéissant à son Seigneur comme il se doit,"],[["وَإِذَا","الْأَرْضُ","مُدَّتْ"],["et quand","la terre","sera étendue"],"lorsque la terre sera étendue,"],[["وَأَلْقَتْ","مَا","فِيهَا","وَتَخَلَّتْ"],["et rejettera","ce qui","est en elle","et se videra"],"qu’elle se videra, rejetant son contenu,"],[["وَأَذِنَتْ","لِرَبِّهَا","وَحُقَّتْ"],["et obéira","à son Seigneur","et y sera tenue"],"obéissant à son Seigneur comme il se doit."],[["يَا أَيُّهَا","الْإِنسَانُ","إِنَّكَ","كَادِحٌ","إِلَىٰ","رَبِّكَ","كَدْحًا","فَمُلَاقِيهِ"],["ô toi","l’homme","certes tu","peines","vers","ton Seigneur","avec peine","alors tu Le rencontreras"],"Homme ! Tes œuvres te mèneront à ton Seigneur que tu rencontreras."],[["فَأَمَّا","مَنْ","أُوتِيَ","كِتَابَهُ","بِيَمِينِهِ"],["alors quant à","celui qui","aura reçu","son livre","dans sa main droite"],"Celui qui recevra le registre de ses œuvres dans la main droite"],[["فَسَوْفَ","يُحَاسَبُ","حِسَابًا","يَسِيرًا"],["alors bientôt","il sera jugé","d’un jugement","facile"],"sera jugé avec la plus grande indulgence"],[["وَيَنقَلِبُ","إِلَىٰ","أَهْلِهِ","مَسْرُورًا"],["et il retournera","vers","sa famille","joyeux"],"et ira trouver les siens, le cœur rempli de joie."],[["وَأَمَّا","مَنْ","أُوتِيَ","كِتَابَهُ","وَرَاءَ","ظَهْرِهِ"],["et quant à","celui qui","aura reçu","son livre","derrière","son dos"],"Quant à celui qui recevra le registre de ses œuvres derrière le dos,"],[["فَسَوْفَ","يَدْعُو","ثُبُورًا"],["alors bientôt","il appellera","l’anéantissement"],"il appellera le malheur sur lui,"],[["وَيَصْلَىٰ","سَعِيرًا"],["et il brûlera","dans un brasier"],"et sera introduit dans les flammes de l’Enfer."],[["إِنَّهُ","كَانَ","فِي","أَهْلِهِ","مَسْرُورًا"],["certes il","était","parmi","sa famille","joyeux"],"Il goûtait auprès des siens un bonheur éphémère,"],[["إِنَّهُ","ظَنَّ","أَن","لَّن","يَحُورَ"],["certes il","a pensé","que","ne… jamais","il reviendrait"],"pensant qu’il ne retournerait jamais à son Créateur,"],[["بَلَىٰ","إِنَّ","رَبَّهُ","كَانَ","بِهِ","بَصِيرًا"],["si","certes","son Seigneur","était","de lui","Clairvoyant"],"mais sans savoir que son Seigneur l’observait."],[["فَلَا","أُقْسِمُ","بِالشَّفَقِ"],["alors non","Je jure","par le crépuscule"],"Je jure par le crépuscule !"],[["وَاللَّيْلِ","وَمَا","وَسَقَ"],["et par la nuit","et ce qu’","elle rassemble"],"Par la nuit et ce qu’elle enveloppe !"],[["وَالْقَمَرِ","إِذَا","اتَّسَقَ"],["et par la lune","quand","elle est pleine"],"Par la lune à son plein !"],[["لَتَرْكَبُنَّ","طَبَقًا","عَن","طَبَقٍ"],["vous passerez assurément","étape","après","étape"],"Vous endurerez une succession d’épreuves."],[["فَمَا","لَهُمْ","لَا","يُؤْمِنُونَ"],["qu’y a-t-il donc","pour eux","ne… pas","ils croient"],"Qu’ont-ils donc à persister dans l’impiété"],[["وَإِذَا","قُرِئَ","عَلَيْهِمُ","الْقُرْآنُ","لَا","يَسْجُدُونَ ۩"],["et quand","est lu","à eux","le Coran","ne… pas","ils se prosternent"],"et à ne pas se soumettre lorsque le Coran leur est récité ?"],[["بَلِ","الَّذِينَ","كَفَرُوا","يُكَذِّبُونَ"],["plutôt","ceux qui","ont mécru","traitent de mensonge"],"Les mécréants préfèrent, au contraire, renier la vérité."],[["وَاللَّهُ","أَعْلَمُ","بِمَا","يُوعُونَ"],["et Allah","sait mieux","ce que","ils renferment"],"Mais Allah connaît parfaitement le fond de leurs pensées."],[["فَبَشِّرْهُم","بِعَذَابٍ","أَلِيمٍ"],["annonce-leur donc","un supplice","très douloureux"],"Annonce-leur un douloureux châtiment qu’ils devront affronter,"],[["إِلَّا","الَّذِينَ","آمَنُوا","وَعَمِلُوا","الصَّالِحَاتِ","لَهُمْ","أَجْرٌ","غَيْرُ","مَمْنُونٍ"],["sauf","ceux qui","ont cru","et ont accompli","les bonnes œuvres","pour eux","une récompense","non","interrompue"],"tandis que ceux qui croient et accomplissent de bonnes œuvres obtiendront une récompense dont ils ne seront jamais privés."]]}